generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CollectionPage {
  id          String       @id @default(cuid())
  slug        String       @unique
  companyName String
  title       String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]
}

model Campaign {
  id                  String             @id @default(cuid())
  ownerUserId         String
  brandName           String
  brandSlug           String
  brandLogoUrl        String?
  name                String
  description         String?
  rewardText          String
  rewardValue         String?
  hasNoEndDate        Boolean            @default(true)
  endsAt              DateTime?
  questionDisplayMode String             @default("ALL_AT_ONCE")
  inviteMessage       String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  questions           CampaignQuestion[]
  submissions         Submission[]
  webhookEndpoint     WebhookEndpoint?

  @@index([brandSlug])
  @@index([ownerUserId])
}

model CampaignQuestion {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  text       String
  required   Boolean  @default(false)
  sortOrder  Int
  createdAt  DateTime @default(now())

  @@index([campaignId, sortOrder])
}

model Submission {
  id                String             @id @default(cuid())
  collectionPage    CollectionPage?    @relation(fields: [collectionPageId], references: [id])
  collectionPageId  String?
  campaign          Campaign?          @relation(fields: [campaignId], references: [id])
  campaignId        String?
  reviewerName      String
  reviewerEmail     String
  reviewerRating    Int?
  answers           Json?
  videoKey          String
  durationSeconds   Int?
  status            String             @default("pending")
  rewardPending     Boolean            @default(false)
  aiStatus          SubmissionAiStatus @default(NOT_REQUESTED)
  aiTranscript      String?
  aiGeneratedReview String?
  aiKeyPhrase       String?
  aiError           String?
  aiModel           String?
  aiProcessedAt     DateTime?
  createdAt         DateTime           @default(now())

  @@index([collectionPageId])
  @@index([campaignId])
  @@index([status])
  @@index([aiStatus])
}

enum SubmissionAiStatus {
  NOT_REQUESTED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model BrandProfile {
  id             String   @id @default(cuid())
  ownerUserId    String   @unique
  brandName      String   @default("Tellr.me")
  primaryColor   String   @default("#ff5c35")
  secondaryColor String   @default("#111318")
  logoUrl        String?
  websiteUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerUserId])
}

model WallOfLove {
  id                            String   @id @default(cuid())
  ownerUserId                   String   @unique
  slug                          String   @unique
  title                         String   @default("Real people. Real results.")
  subtitle                      String?  @default("These are our customers speaking — unscripted, unedited, unrehearsed.")
  isPublished                   Boolean  @default(false)
  includeAllCampaigns           Boolean  @default(true)
  selectedCampaignIds           String[] @default([])
  includeAllApprovedSubmissions Boolean  @default(true)
  selectedSubmissionIds         String[] @default([])
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([ownerUserId, isPublished])
}

model WebhookEndpoint {
  id               String            @id @default(cuid())
  ownerUserId      String
  campaignId       String?           @unique
  url              String
  description      String?
  subscribedEvents String[]          @default([])
  signingSecret    String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deliveries       WebhookDelivery[]
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, url])
  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, isActive])
  @@index([ownerUserId, campaignId])
}

model WebhookEvent {
  id            String            @id @default(cuid())
  ownerUserId   String
  type          String
  schemaVersion Int               @default(1)
  payload       Json
  createdAt     DateTime          @default(now())
  deliveries    WebhookDelivery[]

  @@index([ownerUserId, createdAt])
  @@index([type, createdAt])
}

model WebhookDelivery {
  id             String          @id @default(cuid())
  eventId        String
  endpointId     String
  status         String          @default("PENDING")
  attemptCount   Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  lastAttemptAt  DateTime?
  responseStatus Int?
  lastError      String?
  lockedAt       DateTime?
  lockedBy       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt, createdAt])
  @@index([endpointId, createdAt])
  @@index([lockedAt])
}
